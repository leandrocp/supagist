# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
# Playwright saved auth state contains session cookies — never commit
e2e/.auth/user.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# supabase local state
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# ai / local agent artifacts
.mcp.json
paseo.json
.claude/settings.local.json
.claude/skills/impeccable
.agents/skills/impeccable/
.impeccable/
.pi-subagents/

# editor-local settings
.vscode/
