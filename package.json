{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run lib/__integration__",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:build": "npm run build && PLAYWRIGHT_PRODUCTION=1 playwright test --project=chromium",
    "test:e2e:auth": "playwright test e2e/auth.test.ts --project=chromium-auth",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
